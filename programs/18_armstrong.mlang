// Title: Armstrong number
// Category: Number programs
// 153 = 1x1x1 + 5x5x5 + 3x3x3
int n = 153;
int temp = n;
int total = 0;
int digit = 0;
while temp > 0
  set digit = temp % 10;
  set total = total + digit * digit * digit;
  set temp = temp / 10;
end_while
if total == n
  print n, " is an Armstrong number";
else
  print n, " is not an Armstrong number";
end_if
