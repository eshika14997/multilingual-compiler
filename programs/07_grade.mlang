// Title: Grade from marks
// Category: Decision making
// Nested if / else chain
int marks = 78;
if marks >= 90
  print "Grade : A+";
else
  if marks >= 75
    print "Grade : A";
  else
    if marks >= 60
      print "Grade : B";
    else
      if marks >= 40
        print "Grade : C";
      else
        print "Grade : Fail";
      end_if
    end_if
  end_if
end_if
